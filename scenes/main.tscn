[node name="Label" type="Label" parent="." unique_id=1697971756]
custom_minimum_size = Vector2(600, 100)
offset_left = 131.0
offset_top = -177.0
offset_right = 731.0
offset_bottom = -21.0
text = "F键为飞行，尽量少用，除非卡住了。双击a或d可以闪现，空格跳跃，可以二段跳。鼠标左键射击，boss半血会无敌5s，小红旗为存档点，雪人为敌人，玩家生命值为10点，当玩家生命值为0时，会优先扣除5枚金币复活，当金币也不足以复活时，则游戏结束，地刺会扣血，按下p键可以无敌，防止卡关"
label_settings = SubResource("LabelSettings_y64c1")
autowrap_mode = 1

